# AI Email Analyzer - Пример конфигурации
# Скопируйте этот файл как .env и заполните своими данными

# ========================================
# ОБЯЗАТЕЛЬНЫЕ ПАРАМЕТРЫ
# ========================================

# API ключ Gemini AI (обязательно)
# Получить на: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ========================================
# НАСТРОЙКИ MAIL.RU (если используется)
# ========================================

# Email адрес Mail.ru
MAILRU_USERNAME=your_email@mail.ru

# Пароль приложения Mail.ru (НЕ основной пароль!)
# Создать в настройках безопасности Mail.ru
MAILRU_PASSWORD=your_app_password_here

# ========================================
# ОПЦИОНАЛЬНЫЕ ПАРАМЕТРЫ
# ========================================

# Модель Gemini AI (по умолчанию: gemini-2.5-flash)
GOOGLE_MODEL=gemini-2.5-flash

# Файл с учетными данными Gmail API (по умолчанию: credentials.json)
CLIENT_SECRETS_FILE=credentials.json

# ========================================
# ОГРАНИЧЕНИЯ И ЛИМИТЫ
# ========================================

# Максимальная длина текста письма для анализа (символы)
MAX_EMAIL_LENGTH=10000

# Максимальный размер письма для обработки (байты, 50MB)
MAX_EMAIL_SIZE=52428800

# Максимальный размер вложения (байты, 10MB)
MAX_ATTACHMENT_SIZE=10485760

# ========================================
# НАСТРОЙКИ ПОВТОРНЫХ ПОПЫТОК
# ========================================

# Максимальное количество попыток при ошибках
MAX_RETRIES=3

# Задержка между попытками (секунды)
RETRY_DELAY=1.0

# ========================================
# НАСТРОЙКИ ЛОГИРОВАНИЯ
# ========================================

# Уровень логирования: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Файл для сохранения логов
LOG_FILE=email_analyzer.log

# Формат логов
LOG_FORMAT=%(asctime)s - %(levelname)s - %(message)s

# ========================================
# НАСТРОЙКИ ОТЧЕТОВ
# ========================================

# Формат отчета по умолчанию: markdown, json, csv
DEFAULT_FORMAT=markdown

# Язык отчета: ru, en
DEFAULT_LANGUAGE=ru

# ========================================
# СЕТЕВЫЕ НАСТРОЙКИ
# ========================================

# Таймаут сокетов (секунды)
SOCKET_TIMEOUT=30

# Таймаут API запросов (секунды)
API_TIMEOUT=60

# ========================================
# ИНСТРУКЦИИ ПО НАСТРОЙКЕ
# ========================================

# 1. GEMINI API:
#    - Перейдите на https://aistudio.google.com/app/apikey
#    - Создайте новый API ключ
#    - Скопируйте и вставьте его в GEMINI_API_KEY

# 2. MAIL.RU:
#    - Включите двухфакторную аутентификацию
#    - Перейдите в Настройки → Безопасность → Пароли для внешних приложений
#    - Создайте новый пароль приложения
#    - Используйте этот пароль в MAILRU_PASSWORD

# 3. GMAIL:
#    - Перейдите в Google Cloud Console
#    - Создайте проект и включите Gmail API
#    - Создайте учетные данные OAuth 2.0
#    - Скачайте credentials.json в папку с программой

# 4. БЕЗОПАСНОСТЬ:
#    - Никогда не публикуйте файл .env в открытых репозиториях
#    - Используйте пароли приложений, а не основные пароли
#    - Регулярно обновляйте API ключи
